APP_NAME=Hireboard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Used for links built outside a request (queued mail, artisan). During a
# request, Laravel builds links from the request's host instead.
APP_URL=http://localhost:8000

# Hostnames that serve the dashboard (comma-separated, no port).
APP_HOSTS=localhost
# Customers can't claim this domain or its subdomains.
APP_DOMAIN=hireboard.app

# "saascustomdomains" (default) or "caddy" to run your own proxy.
DOMAINS_PROVIDER=saascustomdomains

# SaaS Custom Domains. Remove SCD_API_URL to use the real API.
SCD_API_URL=http://localhost:4010
SCD_API_TOKEN=scd_test_token
SCD_ACCOUNT_UUID=acc_local
SCD_UPSTREAM_UUID=upstream_local
# The upstream's auth token, sent in X-SaaS-Domains-Auth-Token.
PROXY_AUTH_TOKEN=local_proxy_token
# The token on your webhook in the dashboard.
SCD_WEBHOOK_TOKEN=local_webhook_token

# Proxies allowed to set X-Forwarded-For and X-Forwarded-Proto. Use "*"
# when only your load balancer (or SaaS Custom Domains) can reach the app,
# so links on customer domains are https://.
TRUSTED_PROXIES=

# Only for DOMAINS_PROVIDER=caddy: what customers point their DNS at.
CNAME_TARGET=in.hireboard.app
SERVER_IPS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Keep this null. A cookie domain like .hireboard.app is rejected by the
# browser on customer domains, so sessions and CSRF tokens never stick.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
